# Safe default: no external API calls or writes.
MODE=SIMULATION
RUN_LIVE=false
DATA_DIR=data

# LIVE only. Use a service-user API key with session/context permissions.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU=5

# Your Superset FORK, never this platform repo or apache/superset.
GITHUB_REPOSITORY=example/superset
GITHUB_REPOSITORY_ID=1
GITHUB_BASE_BRANCH=remediation-demo
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=local-simulation-only
# Replace after manually creating the approved, confirmed case issues.
CASE_ISSUES={}

EVALUATOR_IMAGE=remediation-superset-eval:baseline
POLL_SECONDS=10
JOB_TIMEOUT_SECONDS=3600
VALIDATION_TIMEOUT_SECONDS=300
