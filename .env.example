# Never commit .env. Starting the web service does not spend credits.
MODE=LIVE
DATA_DIR=data
ENABLE_LIVE=false

DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_MAX_ACU=3

# Use a dedicated public Superset fork, not this platform repository or upstream.
GITHUB_REPOSITORY=
GITHUB_REPOSITORY_ID=0
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
BASE_BRANCH=remediation-demo
CASE_ISSUES={}
# After creating issues: {"histogram-invalid-column":123,"schema-missing-engine":124,"import-unparseable-yaml":125}

# A prepared Superset checkout/venv at the pinned SHA. No test dependencies are faked.
SUPERSET_REPO_PATH=.superset
SUPERSET_PYTHON=.superset/.venv/bin/python
# Optional: absolute path to your dedicated Superset test configuration.
# SUPERSET_CONFIG_PATH=
# Candidate Python is not sandboxed. Enable only in a disposable environment.
ALLOW_LOCAL_VALIDATION=false
VALIDATION_TIMEOUT_SECONDS=180
JOB_TIMEOUT_SECONDS=3600
POLL_SECONDS=5
